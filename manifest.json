{
  "manifest_version": 3,
  "name": "Rainbow Collector Extension",
  "version": "0.1.14",
  "description": "Browser workflow collector.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "nativeMessaging"],
  "host_permissions": [
    "http://211.109.22.33:8791/*",
    "https://rainbowlab.ai.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://211.109.22.33:8791/*",
        "https://rainbowlab.ai.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Rainbow Collector"
  }
}
