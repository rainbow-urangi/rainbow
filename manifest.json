{
  "manifest_version": 3,
  "name": "Rainbow Collector Extension 0.1.2",
  "version": "0.1.2",
  "description": "",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "http://localhost:4175/*",
    "http://127.0.0.1:4175/*",
    "http://localhost:4181/*",
    "http://127.0.0.1:4181/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://example.websquare.kr/*",
    "https://demo.tobesoft.com/*",
    "https://c4web.c4mix.com/*",
    "http://192.168.131.128:8080/*",
    "https://rainbowlab.ai.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4175/*",
        "http://127.0.0.1:4175/*",
        "http://localhost:4181/*",
        "http://127.0.0.1:4181/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://example.websquare.kr/*",
        "https://demo.tobesoft.com/*",
        "https://c4web.c4mix.com/*",
        "https://rainbowlab.ai.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Collector Test Extension"
  }
}
